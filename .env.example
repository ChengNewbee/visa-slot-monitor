# Monitoring target
VISA_CITY=北京
VISA_TYPE=B1/B2
VISA_DESCRIPTION=All Others
VISA_START=TODAY
VISA_END=2026-11-30
VISA_POLL_SECONDS=60

# Push notification (free; use a long, private topic name)
VISA_NTFY_TOPIC=replace-with-a-private-topic
VISA_NTFY_SERVER=https://ntfy.sh

# QQ email. Use a QQ Mail SMTP authorization code, never the QQ password.
VISA_EMAIL_TO=your-number@qq.com
VISA_SMTP_HOST=smtp.qq.com
VISA_SMTP_PORT=465
VISA_SMTP_USER=your-number@qq.com
VISA_SMTP_PASSWORD=

# Optional behaviour
VISA_HEALTH_HOUR=9
VISA_STATE=.state/state.json
